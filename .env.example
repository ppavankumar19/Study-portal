# Study Portal – Environment Variables
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must never be committed.

# Server
PORT=3000

# Admin credentials – change these before deploying
ADMIN_USER=admin
ADMIN_PASS=admin

# Cookie signing secret – use a long random string
COOKIE_SECRET=change-this-to-a-long-random-string
